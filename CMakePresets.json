{
  "version": 3,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    { "name": "sword",  "inherits": "base", "displayName": "Pokemon Sword 1.0.0",  "cacheVariables": { "PKMN_GAME": "sword" } },
    { "name": "shield", "inherits": "base", "displayName": "Pokemon Shield 1.0.0", "cacheVariables": { "PKMN_GAME": "shield" } }
  ],
  "buildPresets": [
    { "name": "sword",  "configurePreset": "sword" },
    { "name": "shield", "configurePreset": "shield" }
  ]
}
